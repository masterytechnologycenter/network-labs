      <node id="2" name="ISP-R" type="iol" template="iol" image="i86bi-linux-l3-adventerprisek9-15.4.2T.bin" ethernet="1" serial="0" nvram="1024" ram="1024" console="telnet" delay="0" icon="Router-3D-Gen1-S.svg" config="1" left="600" top="160">
