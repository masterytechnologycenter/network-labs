      <node id="4" name="WEB-DMZ" type="iol" template="iol" image="i86bi-linux-l3-adventerprisek9-15.4.2T.bin" ethernet="1" serial="0" nvram="1024" ram="1024" console="telnet" delay="0" icon="Server-2D-WEB-S.svg" config="1" left="850" top="600">
        <interface id="0" name="e0/0" type="ethernet" network_id="3"/>
      </node>
      <node id="5" name="PC-ADMIN" type="vpcs" template="vpcs" image="" ethernet="1" console="telnet" delay="0" icon="PC-2D-Desktop-Generic-S.svg" config="1" left="350" top="600">
        <interface id="0" name="eth0" type="ethernet" network_id="4"/>
      </node>
