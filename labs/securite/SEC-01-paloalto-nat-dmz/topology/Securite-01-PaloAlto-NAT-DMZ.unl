      <node id="3" name="PA-FW" type="qemu" template="paloalto" image="paloalto-10.2.9" uuid="6bfe2287-cfad-5ba8-9b5c-a80bab7949c8" cpu="2" ram="6144" ethernet="7" console="telnet" delay="0" icon="Firewall-2D-PA-S.svg" config="0" left="600" top="380">
