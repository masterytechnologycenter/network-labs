<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<lab name="Securite-01-PaloAlto-Retour-Asymetrique" id="aa6eefea-6b34-50d3-8ccb-dd001e7ef2af" version="1" scripttimeout="300" lock="0" author="Hilaire TCHOUATEU">
  <description>SEC-01 · DMZ : le site web coupé par une carte de sauvegarde (routage asymétrique)</description>
  <topology>
    <nodes>
      <node id="1" name="CLIENT" type="iol" template="iol" image="i86bi-linux-l3-adventerprisek9-15.4.2T.bin" ethernet="1" serial="0" nvram="1024" ram="1024" console="telnet" delay="0" icon="PC-2D-Laptop-Generic-S.svg" config="1" left="110" top="70">
        <interface id="0" name="e0/0" type="ethernet" network_id="1"/>
      </node>
      <node id="2" name="ISP-R" type="iol" template="iol" image="i86bi-linux-l3-adventerprisek9-15.4.2T.bin" ethernet="1" serial="0" nvram="1024" ram="1024" console="telnet" delay="0" icon="Router-3D-Gen1-S.svg" config="1" left="470" top="70">
        <interface id="0" name="e0/0" type="ethernet" network_id="1"/>
        <interface id="16" name="e0/1" type="ethernet" network_id="2"/>
      </node>
      <node id="3" name="PA-FW" type="qemu" template="paloalto" image="paloalto-10.2.9" uuid="6bfe2287-cfad-5ba8-9b5c-a80bab7949c8" cpu="2" ram="6144" ethernet="7" console="telnet" delay="0" icon="Firewall-2D-PA-S.svg" config="1" left="470" top="250">
        <interface id="1" name="eth1/1" type="ethernet" network_id="2"/>
        <interface id="2" name="eth1/2" type="ethernet" network_id="3"/>
        <interface id="3" name="eth1/3" type="ethernet" network_id="4"/>
      </node>
      <node id="4" name="CORE1" type="iol" template="iol" image="i86bi-linux-l3-adventerprisek9-15.4.2T.bin" ethernet="1" serial="0" nvram="1024" ram="1024" console="telnet" delay="0" icon="Switch-3D-L3-S.svg" config="1" left="190" top="440">
        <interface id="0" name="e0/0" type="ethernet" network_id="4"/>
        <interface id="16" name="e0/1" type="ethernet" network_id="5"/>
      </node>
      <node id="5" name="WEB-DMZ" type="iol" template="iol" image="i86bi-linux-l3-adventerprisek9-15.4.2T.bin" ethernet="1" serial="0" nvram="1024" ram="1024" console="telnet" delay="0" icon="Server-2D-WEB-S.svg" config="1" left="700" top="440">
        <interface id="0" name="e0/0" type="ethernet" network_id="3"/>
        <interface id="16" name="e0/1" type="ethernet" network_id="5"/>
      </node>
    </nodes>
    <networks>
      <network id="1" type="bridge" name="Net-CLIENT-ISP-R" left="290" top="70" visibility="0"/>
      <network id="2" type="bridge" name="Net-ISP-R-PA-FW" left="470" top="160" visibility="0"/>
      <network id="3" type="bridge" name="Net-PA-FW-WEB-DMZ" left="585" top="345" visibility="0"/>
      <network id="4" type="bridge" name="Net-PA-FW-CORE1" left="330" top="345" visibility="0"/>
      <network id="5" type="bridge" name="Net-CORE1-WEB-DMZ" left="445" top="440" visibility="0"/>
    </networks>
  </topology>
